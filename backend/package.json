    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.2.0",
    "node-html-parser": "^9.0.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.0",
